# ── URL de l'API Backend Express ──────────────────────────────
# En développement local (backend sur port 5000) :
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# En production, cette variable est configurée directement sur Vercel :
# NEXT_PUBLIC_API_URL=https://backend-production-5ffe3.up.railway.app/api
