# ══════════════════════════════════════════════════════════════
# TechNova Store — Configuration Backend
# Copiez ce fichier : cp .env.example .env
# Ne committez JAMAIS le fichier .env (il est dans .gitignore)
# ══════════════════════════════════════════════════════════════

# ── Serveur Express ───────────────────────────────────────────
PORT=5000

# ── Supabase ──────────────────────────────────────────────────
# Récupérez ces valeurs dans votre tableau de bord Supabase :
# Project Settings → API → Project URL et Legacy API Keys → service_role
#
# ⚠️ Utilisez la clé "service_role" (commence par eyJ...), PAS la clé "anon"
#    La service_role bypasse le Row Level Security — indispensable côté backend.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# ── JWT ───────────────────────────────────────────────────────
# Choisissez une chaîne aléatoire longue (minimum 32 caractères)
# Exemple de génération : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changez_moi_avec_une_chaine_aleatoire_longue_et_secrete
JWT_EXPIRES_IN=7d

# ── WhatsApp ──────────────────────────────────��───────────────
# Numéro du service client TechNova au format international sans le +
# Exemple Maroc : 212612345678 (correspond à +212 6 12 34 56 78)
WHATSAPP_NUMBER=212600000000

# ── CORS ──────────────────────────────────────────────────────
# URL exacte du frontend (sans slash final)
# En développement local :
FRONTEND_URL=http://localhost:3000
# En production, ajoutez aussi l'URL Vercel dans le code (voir src/server.js)

# ── Chatbot IA (optionnel) ────────────────────────────────────
# Clé API Google Gemini pour le chatbot assistant
# Obtenez-la gratuitement sur https://aistudio.google.com
# Si absente, le chatbot fonctionne en mode dégradé (réponses statiques)
GEMINI_API_KEY=
