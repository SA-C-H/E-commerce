# ── Backend — Copiez ce fichier en .env et remplissez les valeurs ──

# Port du serveur Express
PORT=5000

# Supabase — Récupérez ces valeurs dans Settings > API de votre projet Supabase
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=votre_service_role_key_supabase

# JWT — Choisissez une chaîne aléatoire longue et gardez-la secrète
JWT_SECRET=changez_moi_avec_une_chaine_aleatoire_longue_et_secrete
JWT_EXPIRES_IN=7d

# WhatsApp — Numéro Maroc au format international (sans +)
WHATSAPP_NUMBER=212600000000

# CORS — URL du frontend en développement
FRONTEND_URL=http://localhost:3000
